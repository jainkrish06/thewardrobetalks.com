# Database config
MONGO_URL=mongodb://localhost:27017
DB_NAME=wardrobe_talks

# Domains/URLs config (no trailing slashes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary credentials for CDN image storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Secret key for admin authentication session/JWT
AUTH_SECRET=generate_a_random_32_character_string_here

# SMTP credentials for email forwarding
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
INQUIRY_TO=owner@example.com
